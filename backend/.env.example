# Database Connection String
# For local SQLite testing (default if not set):
DATABASE_URL=sqlite:///./taskflow.db

# For PostgreSQL (e.g. Neon, Render PostgreSQL):
# DATABASE_URL=postgresql+psycopg://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# CORS allowed origins (comma-separated, or * for development)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# AI Chatbot Configuration (Optional - Smart built-in NLP works even without API key)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
